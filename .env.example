# Scanner
TOP_N=50
CANDIDATES_K=20
BLACKLIST=
METRICS_VERSION=v1
INCLUDE_SYMBOLS_IN_MONGO=false

# Infrastructure
REDIS_URL=redis://redis:6379/0
MONGO_URI=mongodb://mongo:27017

# Logging
LOG_LEVEL=INFO

# API
# Set to true in production to disable /docs, /redoc, /openapi.json
PRODUCTION=false
# Comma-separated list of allowed CORS origins, e.g. https://app.example.com,https://www.example.com
CORS_ORIGINS=
API_WORKERS=3
