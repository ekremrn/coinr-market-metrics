# Scanner
TOP_N=20
CANDIDATES_K=8
BLACKLIST=
METRICS_VERSION=v1.2
INCLUDE_SYMBOLS_IN_MONGO=false
# Universe quality gates: remove wash-traded / illiquid tokens before metric computation.
# MIN_QUOTE_VOLUME: minimum 24h notional volume in USD (default $100M).
# MAX_SPREAD_BPS: maximum bid/ask spread in basis points — tokens above this are excluded (default 3.5 bps).
MIN_QUOTE_VOLUME=100000000
MAX_SPREAD_BPS=3.5

# Infrastructure
REDIS_URL=redis://redis:6379/0
MONGO_URI=mongodb://mongo:27017

# Logging
LOG_LEVEL=INFO

# API
# Set to true in production to disable /docs, /redoc, /openapi.json
PRODUCTION=false
# Comma-separated list of allowed CORS origins, e.g. https://app.example.com,https://www.example.com
CORS_ORIGINS=
API_WORKERS=3
